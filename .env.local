# Copy to .env.local for local development.

# Base URL of the API. Leave empty for same-origin requests, which is what you
# want while the API is mocked -- pointing this at a port another local service
# happens to be using sends requests somewhere unrelated.
VITE_API_URL=

# Serve the auth API from in-browser mocks. Set to false once the real
# backend is available.
VITE_USE_MOCKS=true
